<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cell_root" android:layout_width="match_parent" android:layout_height="27dp"
    android:orientation="vertical" android:gravity="center" android:layout_margin="1dp">
    <TextView android:id="@+id/cell_day" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="13sp" android:gravity="center" />
    <TextView android:id="@+id/cell_dot" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="5sp" android:gravity="center" android:includeFontPadding="false" />
</LinearLayout>
